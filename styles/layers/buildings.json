[
  {
    "id": "buildings",
    "type": "fill",
    "source": "osm",
    "source-layer": "planet_osm_polygon",
    "filter": ["has", "building"],
    "minzoom": 14,
    "maxzoom": 22,
    "paint": {
      "fill-color": {
        "stops": [
          [14, "#e8e0d8"],
          [16, "#d9d0c9"],
          [18, "#d0c8c0"]
        ]
      },
      "fill-opacity": {
        "stops": [
          [14, 0.6],
          [16, 0.8],
          [18, 0.9]
        ]
      },
      "fill-outline-color": {
        "stops": [
          [14, "#d0c8c0"],
          [16, "#c0b8b0"],
          [18, "#b0a8a0"]
        ]
      },
      "fill-outline-width": {
        "stops": [
          [14, 0.5],
          [18, 1.5]
        ]
      }
    }
  },
  {
    "id": "buildings-important",
    "type": "fill",
    "source": "osm",
    "source-layer": "planet_osm_polygon",
    "filter": ["any", ["==", "amenity", "place_of_worship"], ["==", "aeroway", "terminal"], ["==", "building", "train_station"]],
    "minzoom": 13,
    "maxzoom": 22,
    "paint": {
      "fill-color": {
        "stops": [
          [13, "#d0c8b8"],
          [16, "#c0b8a8"],
          [18, "#b0a898"]
        ]
      },
      "fill-outline-color": "#a09888",
      "fill-outline-width": 1.5
    }
  },
  {
    "id": "buildings-3d",
    "type": "fill-extrusion",
    "source": "osm",
    "source-layer": "planet_osm_polygon",
    "filter": ["has", "building"],
    "minzoom": 16,
    "maxzoom": 22,
    "paint": {
      "fill-extrusion-color": {
        "stops": [
          [16, "#d9d0c9"],
          [18, "#d0c8c0"],
          [20, "#c8c0b8"]
        ]
      },
      "fill-extrusion-height": {
        "property": "building:levels",
        "type": "identity",
        "stops": [
          [1, 3],
          [3, 8],
          [6, 15],
          [10, 25]
        ]
      },
      "fill-extrusion-base": 0,
      "fill-extrusion-opacity": 0.8,
      "fill-extrusion-vertical-gradient": true
    }
  }
]