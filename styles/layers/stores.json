[
  {
    "id": "stores-pending",
    "type": "circle",
    "source": "stores",
    "filter": ["==", "status", "pending"],
    "minzoom": 12,
    "maxzoom": 22,
    "paint": {
      "circle-radius": {
        "stops": [
          [12, 4],
          [16, 8],
          [20, 14]
        ]
      },
      "circle-color": "#f39c12",
      "circle-stroke-width": 2,
      "circle-stroke-color": "#ffffff",
      "circle-opacity": 0.8
    }
  },
  {
    "id": "stores-approved",
    "type": "symbol",
    "source": "stores",
    "filter": ["==", "status", "approved"],
    "minzoom": 12,
    "maxzoom": 22,
    "layout": {
      "icon-image": [
        "match",
        ["get", "is_warehouse"],
        true, "warehouse",
        "store"
      ],
      "icon-size": {
        "stops": [
          [12, 0.4],
          [16, 0.6],
          [20, 1]
        ]
      },
      "icon-allow-overlap": false,
      "text-field": "{name}",
      "text-font": ["Vazirmatn Thin", "Arial Regular"],
      "text-offset": [0, 1.5],
      "text-anchor": "top",
      "text-size": {
        "stops": [
          [12, 8],
          [16, 10],
          [20, 12]
        ]
      },
      "text-padding": 4
    },
    "paint": {
      "text-color": "#2c2c2c",
      "text-halo-color": "#ffffff",
      "text-halo-width": 2,
      "text-halo-blur": 1
    }
  },
  {
    "id": "stores-heatmap",
    "type": "heatmap",
    "source": "stores",
    "filter": ["==", "status", "approved"],
    "minzoom": 8,
    "maxzoom": 14,
    "paint": {
      "heatmap-weight": 1,
      "heatmap-intensity": {
        "stops": [
          [8, 0.2],
          [11, 0.8],
          [14, 1.5]
        ]
      },
      "heatmap-color": [
        "interpolate",
        ["linear"],
        ["heatmap-density"],
        0, "rgba(0,0,255,0)",
        0.1, "rgba(0,0,255,0.1)",
        0.3, "rgba(0,255,255,0.3)",
        0.5, "rgba(0,255,0,0.5)",
        0.7, "rgba(255,255,0,0.7)",
        0.9, "rgba(255,0,0,1)"
      ],
      "heatmap-radius": {
        "stops": [
          [8, 30],
          [12, 20],
          [14, 10]
        ]
      },
      "heatmap-opacity": 0.8
    }
  },
  {
    "id": "stores-cluster",
    "type": "circle",
    "source": "stores",
    "filter": ["has", "point_count"],
    "minzoom": 8,
    "maxzoom": 14,
    "paint": {
      "circle-color": [
        "step",
        ["get", "point_count"],
        "#51bbd6",
        10, "#f1f075",
        100, "#f28cb1"
      ],
      "circle-radius": [
        "step",
        ["get", "point_count"],
        20,
        10, 30,
        100, 40
      ],
      "circle-stroke-width": 2,
      "circle-stroke-color": "#ffffff"
    },
    "layout": {
      "text-field": "{point_count_abbreviated}",
      "text-font": ["Arial Regular"],
      "text-size": 12,
      "text-allow-overlap": false,
      "text-justify": "center"
    }
  }
]