[
  {
    "id": "landcover-forest",
    "type": "fill",
    "source": "osm",
    "source-layer": "planet_osm_polygon",
    "filter": ["any", ["==", "landuse", "forest"], ["==", "natural", "wood"]],
    "minzoom": 8,
    "maxzoom": 22,
    "paint": {
      "fill-color": {
        "stops": [
          [8, "#d4e0c0"],
          [12, "#c8d8b0"],
          [16, "#b8c8a0"]
        ]
      },
      "fill-opacity": 0.9
    }
  },
