{
  "version": 8,
  "name": "Iran Professional Hybrid Map",
  "glyphs": "http://localhost:3000/font/{fontstack}/{range}",
  
  "sources": {
    "osm": {
      "type": "vector",
      "tiles": ["http://localhost:8001/api/v2/map/tiles/{z}/{x}/{y}"]
    },
    "stores": {
      "type": "geojson",
      "data": "/api/v2/stores/geojson"
    },
    "warehouses": {
      "type": "geojson",
      "data": "/api/v2/warehouses/geojson"
    }
  },
  
  "layers": [

    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f5f0e8"
      }
    },
    

    {
      "id": "water-ocean",
      "type": "fill",
      "source": "osm",
      "source-layer": "planet_osm_polygon",
      "filter": ["any", ["==", "natural", "water"], ["==", "landuse", "reservoir"]],
      "minzoom": 0,
      "maxzoom": 22,
      "paint": {
        "fill-color": "#7ba8b8",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "water-rivers",
      "type": "line",
      "source": "osm",
      "source-layer": "planet_osm_line",
      "filter": ["any", ["==", "waterway", "river"], ["==", "waterway", "stream"]],
      "minzoom": 8,
      "maxzoom": 22,
      "paint": {
        "line-color": "#7ba8b8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 12, 1, 15, 3, 18, 6],
        "line-opacity": 0.8
      }
    },
    
   
    {
      "id": "landcover-forest",
      "type": "fill",
      "source": "osm",
      "source-layer": "planet_osm_polygon",
      "filter": ["any", ["==", "landuse", "forest"], ["==", "natural", "wood"]],
      "minzoom": 8,
      "maxzoom": 22,
      "paint": {
        "fill-color": "#c8d8b0",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "landcover-farmland",
      "type": "fill",
      "source": "osm",
      "source-layer": "planet_osm_polygon",
      "filter": ["==", "landuse", "farmland"],
      "minzoom": 10,
      "maxzoom": 22,
      "paint": {
        "fill-color": "#e8edd0",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "landcover-park",
      "type": "fill",
      "source": "osm",
      "source-layer": "planet_osm_polygon",
      "filter": ["any", ["==", "leisure", "park"], ["==", "landuse", "grass"]],
      "minzoom": 10,
      "maxzoom": 22,
      "paint": {
        "fill-color": "#d0e4c0",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "landcover-residential",
      "type": "fill",
      "source": "osm",
      "source-layer": "planet_osm_polygon",
      "filter": ["==", "landuse", "residential"],
      "minzoom": 10,
      "maxzoom": 22,
      "paint": {
        "fill-color": "#f0ebe3",
        "fill-opacity": 0.7
      }
    },

    {
      "id": "buildings",
      "type": "fill",
      "source": "osm",
      "source-layer": "planet_osm_polygon",
      "filter": ["has", "building"],
      "minzoom": 14,
      "maxzoom": 22,
      "paint": {
        "fill-color": "#d9d0c9",
        "fill-outline-color": "#c0b8b0",
        "fill-outline-width": 0.5
      }
    },
    {
      "id": "buildings-3d",
      "type": "fill-extrusion",
      "source": "osm",
      "source-layer": "planet_osm_polygon",
      "filter": ["has", "building"],
      "minzoom": 16,
      "maxzoom": 22,
      "paint": {
        "fill-extrusion-color": "#d9d0c9",
        "fill-extrusion-height": ["*", 3, ["get", "building:levels"]],
        "fill-extrusion-base": 0,
        "fill-extrusion-opacity": 0.8,
        "fill-extrusion-vertical-gradient": true
      }
    },
    

    {
      "id": "road-motorway-casing",
      "type": "line",
      "source": "osm",
      "source-layer": "planet_osm_line",
      "filter": ["any", ["==", "highway", "motorway"], ["==", "highway", "trunk"]],
      "minzoom": 6,
      "maxzoom": 22,
      "paint": {
        "line-color": "#e07a1b",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 1, 10, 2.5, 14, 5.5, 18, 14],
        "line-opacity": 0.9
      }
    },
    {
      "id": "road-motorway-core",
      "type": "line",
      "source": "osm",
      "source-layer": "planet_osm_line",
      "filter": ["any", ["==", "highway", "motorway"], ["==", "highway", "trunk"]],
      "minzoom": 6,
      "maxzoom": 22,
      "paint": {
        "line-color": "#ffa042",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.5, 10, 1.5, 14, 3.5, 18, 10]
      }
    },
    {
      "id": "road-primary-casing",
      "type": "line",
      "source": "osm",
      "source-layer": "planet_osm_line",
      "filter": ["any", ["==", "highway", "primary"], ["==", "highway", "secondary"]],
      "minzoom": 8,
      "maxzoom": 22,
      "paint": {
        "line-color": "#d6a100",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1, 10, 1.5, 14, 4.5, 18, 11]
      }
    },
    {
      "id": "road-primary-core",
      "type": "line",
      "source": "osm",
      "source-layer": "planet_osm_line",
      "filter": ["any", ["==", "highway", "primary"], ["==", "highway", "secondary"]],
      "minzoom": 8,
      "maxzoom": 22,
      "paint": {
        "line-color": "#ffe082",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.4, 10, 0.8, 14, 2.5, 18, 8]
      }
    },
    {
      "id": "road-residential",
      "type": "line",
      "source": "osm",
      "source-layer": "planet_osm_line",
      "filter": ["any", ["==", "highway", "residential"], ["==", "highway", "service"]],
      "minzoom": 12,
      "maxzoom": 22,
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.5, 14, 1, 18, 4],
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 12, 0.5, 16, 0.8, 20, 1]
      }
    },

    {
      "id": "label-province",
      "type": "symbol",
      "source": "osm",
      "source-layer": "planet_osm_point",
      "filter": ["==", "place", "state"],
      "minzoom": 4,
      "maxzoom": 8,
      "layout": {
        "text-field": "{name}",
        "text-font": ["Vazirmatn Thin", "Arial Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 10, 6, 12, 8, 14]
      },
      "paint": {
        "text-color": "#5a5a5a",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2
      }
    },
    {
      "id": "label-city",
      "type": "symbol",
      "source": "osm",
      "source-layer": "planet_osm_point",
      "filter": ["any", ["==", "place", "city"], ["==", "place", "town"]],
      "minzoom": 6,
      "maxzoom": 12,
      "layout": {
        "text-field": "{name}",
        "text-font": ["Vazirmatn Thin", "Arial Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 8, 8, 10, 10, 12, 12, 14]
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2
      }
    },
    {
      "id": "label-road",
      "type": "symbol",
      "source": "osm",
      "source-layer": "planet_osm_line",
      "filter": ["all", ["has", "name"], ["has", "highway"]],
      "minzoom": 12,
      "maxzoom": 22,
      "layout": {
        "text-field": "{name}",
        "text-font": ["Vazirmatn Thin", "Arial Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12, 8, 16, 10, 20, 12],
        "symbol-placement": "line",
        "text-rotation-alignment": "map",
        "text-spacing": 300
      },
      "paint": {
        "text-color": "#2c2c2c",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2
      }
    },

    {
      "id": "stores-heatmap",
      "type": "heatmap",
      "source": "stores",
      "filter": ["==", "status", "approved"],
      "minzoom": 8,
      "maxzoom": 14,
      "paint": {
        "heatmap-weight": 1,
        "heatmap-intensity": ["interpolate", ["linear"], ["zoom"], 8, 0.2, 11, 0.8, 14, 1.5],
        "heatmap-color": [
          "interpolate",
          ["linear"],
          ["heatmap-density"],
          0, "rgba(0,0,255,0)",
          0.1, "rgba(0,0,255,0.1)",
          0.3, "rgba(0,255,255,0.3)",
          0.5, "rgba(0,255,0,0.5)",
          0.7, "rgba(255,255,0,0.7)",
          0.9, "rgba(255,0,0,1)"
        ],
        "heatmap-radius": ["interpolate", ["linear"], ["zoom"], 8, 30, 12, 20, 14, 10],
        "heatmap-opacity": 0.8
      }
    },
    {
      "id": "stores-approved",
      "type": "symbol",
      "source": "stores",
      "filter": ["==", "status", "approved"],
      "minzoom": 14,
      "maxzoom": 22,
      "layout": {
        "icon-image": ["match", ["get", "is_warehouse"], true, "warehouse", "store"],
        "icon-size": ["interpolate", ["linear"], ["zoom"], 14, 0.4, 16, 0.6, 20, 1],
        "text-field": "{name}",
        "text-font": ["Vazirmatn Thin", "Arial Regular"],
        "text-offset": [0, 1.5],
        "text-anchor": "top",
        "text-size": ["interpolate", ["linear"], ["zoom"], 14, 8, 16, 10, 20, 12]
      },
      "paint": {
        "text-color": "#2c2c2c",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2
      }
    }
  ]
}